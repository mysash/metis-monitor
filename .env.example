# mind. 12 Zeichen, zufällig – der Platzhalter wird abgelehnt (Bearbeiten bleibt dann deaktiviert)
ADMIN_PASSWORD=
# optional: Adresse des Dashboards, wird in Home Assistant als Konfigurations-Link angezeigt
PUBLIC_URL=
# optional: weitere Hostnamen, unter denen das Dashboard aufgerufen wird (Komma-getrennt; IPs gehen immer)
ALLOWED_HOSTS=
# optional: HTTPS direkt (Zertifikat + Schlüssel unter ./data, Pfade im Container)
# SSL_CERTFILE=/data/tls/cert.pem
# SSL_KEYFILE=/data/tls/key.pem
# optional: hinter einem Reverse-Proxy dessen IP (sonst gilt die Admin-Sperre für alle Nutzer gemeinsam)
# FORWARDED_ALLOW_IPS=
# optional: 127.0.0.1 = nur lokal erreichbar (HTTPS-Proxy auf demselben Host)
# HOST=0.0.0.0
